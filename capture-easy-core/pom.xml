<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>app.captureeasy</groupId>
    <artifactId>capture-easy</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>
  <artifactId>capture-easy-core</artifactId>

  <!--
    app.version = semver without SNAPSHOT; used by version.properties (resource filtering)
    and by jpackage.  Update this when bumping the release.
  -->
  <properties>
    <app.version>0.0.1</app.version>
    <app.main.class>app.captureeasy.Boot</app.main.class>
    <!-- fat JAR name produced by maven-shade-plugin -->
    <fat.jar.name>CaptureEasy-${app.version}.jar</fat.jar.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.1stleg</groupId>
      <artifactId>jnativehook</artifactId>
      <version>2.1.0</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi</artifactId>
      <version>5.0.0</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.0.0</version>
    </dependency>
    <dependency>
      <groupId>app.captureeasy</groupId>
      <artifactId>capture-easy-commons</artifactId>
      <version>0.0.1-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>io.github.sanyarnd</groupId>
      <artifactId>app-locker</artifactId>
      <version>1.1.2</version>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.38</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>5.14.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Enable @project.version@ substitution in src/main/resources -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>

    <plugins>
      <!--
        maven-shade-plugin: produces a single executable fat JAR named
        CaptureEasy-{app.version}.jar.  This file is used by both the
        jpackage profiles below AND uploaded directly as a GitHub release
        asset for users who prefer the plain JAR option.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>${fat.jar.name}</finalName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${app.main.class}</mainClass>
                </transformer>
                <!-- Merge service files (Log4j, Jackson, etc.) -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <!-- Strip signature files that break fat JARs -->
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <createDependencyReducedPom>false</createDependencyReducedPom>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- ── Platform packaging profiles ──────────────────────────────────────── -->
  <!--
    Each profile is auto-activated on the matching OS.
    Running `mvn package -Ppackage-windows`  (or on a Windows runner) creates an MSI.
    Running `mvn package -Ppackage-macos`   (or on a macOS runner) creates a DMG.
    Running `mvn package -Ppackage-linux`   (or on a Linux runner) creates a DEB.

    Prerequisites:
      Windows : WiX Toolset 3.x on PATH  (pre-installed on GitHub Actions windows-latest)
      macOS   : Xcode Command Line Tools
      Linux   : dpkg-deb  (`sudo apt-get install dpkg`)
  -->
  <profiles>

    <!-- ── Windows MSI ─────────────────────────────────────────────────────── -->
    <profile>
      <id>package-windows</id>
      <activation>
        <os><family>windows</family></os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <version>1.6.5</version>
            <configuration>
              <name>CaptureEasy</name>
              <appVersion>${app.version}</appVersion>
              <mainJar>${fat.jar.name}.jar</mainJar>
              <mainClass>${app.main.class}</mainClass>
              <input>${project.build.directory}</input>
              <destination>${project.build.directory}/dist</destination>
              <type>MSI</type>
              <winMenu>true</winMenu>
              <winShortcut>true</winShortcut>
              <winDirChooser>true</winDirChooser>
              <winUpgradeUuid>d7a1e3b2-4f9c-4e8a-b5d0-1c2a3e4f5b6c</winUpgradeUuid>
              <vendor>CaptureEasy</vendor>
              <description>CaptureEasy — Screenshot capture tool</description>
            </configuration>
            <executions>
              <execution>
                <id>jpackage-windows</id>
                <phase>package</phase>
                <goals><goal>jpackage</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- ── macOS DMG ───────────────────────────────────────────────────────── -->
    <profile>
      <id>package-macos</id>
      <activation>
        <os><family>mac</family></os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <version>1.6.5</version>
            <configuration>
              <name>CaptureEasy</name>
              <appVersion>${app.version}</appVersion>
              <mainJar>${fat.jar.name}.jar</mainJar>
              <mainClass>${app.main.class}</mainClass>
              <input>${project.build.directory}</input>
              <destination>${project.build.directory}/dist</destination>
              <type>DMG</type>
              <vendor>CaptureEasy</vendor>
              <description>CaptureEasy — Screenshot capture tool</description>
            </configuration>
            <executions>
              <execution>
                <id>jpackage-macos</id>
                <phase>package</phase>
                <goals><goal>jpackage</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- ── Linux DEB ───────────────────────────────────────────────────────── -->
    <profile>
      <id>package-linux</id>
      <activation>
        <os><family>unix</family></os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <version>1.6.5</version>
            <configuration>
              <name>CaptureEasy</name>
              <appVersion>${app.version}</appVersion>
              <mainJar>${fat.jar.name}.jar</mainJar>
              <mainClass>${app.main.class}</mainClass>
              <input>${project.build.directory}</input>
              <destination>${project.build.directory}/dist</destination>
              <type>DEB</type>
              <linuxShortcut>true</linuxShortcut>
              <linuxMenuGroup>Utilities</linuxMenuGroup>
              <vendor>CaptureEasy</vendor>
              <description>CaptureEasy — Screenshot capture tool</description>
            </configuration>
            <executions>
              <execution>
                <id>jpackage-linux</id>
                <phase>package</phase>
                <goals><goal>jpackage</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

  </profiles>
</project>
